# Replaces the held Codex with a blank one (clear-after-run option).
execute if items entity @s weapon.mainhand minecraft:writable_book[minecraft:custom_data~{ccxu:1b}] run item replace entity @s weapon.mainhand with minecraft:writable_book[minecraft:custom_data={ccxu:1b},minecraft:custom_name={text:"Command Codex Ultra",color:"light_purple",italic:0b},minecraft:lore=[{text:"One command per page.",color:"gray",italic:0b},{text:"Hold it, then use /trigger ccxu.run",color:"gray",italic:0b},{text:"Pages starting with # are skipped.",color:"dark_gray",italic:0b}],minecraft:enchantment_glint_override=1b,minecraft:writable_book_content={pages:[{raw:"# cleared"}]}]
